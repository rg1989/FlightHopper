# Copy to .env.local (gitignored). The server reads plain vars; the client reads VITE_* via Vite.
# Contact for the adsb.lol User-Agent (required for ADSB_SOURCE=adsblol and the recorders)
CONTACT=you@example.com
# adsbfi | adsblol | readsb | replay (make / make live pass adsbfi, make replay passes replay)
ADSB_SOURCE=replay
# Upstream budget in req/s. Unset = the source's polite default: adsbfi 0.9 (its public limit is 1 req/s), adsblol 0.04
# (this IP got 429s at 0.08-0.5 req/s on 2026-09-22). make live passes these itself, whatever is set here.
# MAX_RPS=
READSB_URL=http://127.0.0.1:8042
# lat,lon,radius_nm of your receiver's coverage
READSB_COVERAGE=32.01,34.88,200
REPLAY_FILES=data/fixtures/*.jsonl
REPLAY_SPEED=1
# empty = do not record
RECORD_DIR=data/recordings
PORT=8787
SHOW_PIA_LADD=0
# Look up flight routes on adsb.lol (only with ADSB_SOURCE=adsblol; shares MAX_RPS). 1 = on
ROUTES=0
# Alerts: emergency squawks and steep descents anywhere (server/alerts.ts); a live source only, never a replay. EVENTS_DIR holds
# their switch and log: unset = no alerts. `make live` sets EVENTS_DIR=data/events itself, whatever is set here.
# The switch starts off. Turn it on from the app's Events panel, or with
#   curl -X POST 'http://127.0.0.1:8787/api/events?on=1'
# (8787 is PORT; on=0 turns it off again). It then stays as it is across restarts.
# EVENTS_DIR=data/events
# Also push each new alert to your phone with ntfy (ntfy.sh needs no account): subscribe to the topic in the ntfy app. The topic is
# like a password: anyone who knows it can read the alerts, so pick a long random one. Unset = no push.
# NTFY_URL=https://ntfy.sh/your-long-random-topic
# The squawks read as emergencies, and swept worldwide where the source can (adsb.fi): 4-digit octal codes, comma-separated.
# Default 7700,7600,7500 (emergency, radio failure, hijack). To try it out, set ALERT_SQUAWKS=7000: it is a common code, so events
# come within a minute. Leave NTFY_URL unset while you do: every aircraft on a common code becomes an event, and each would be pushed.
# ALERT_SQUAWKS=7700,7600,7500
# Terrain/imagery default to keyless sources (reearth + eox) unless a key is set.
# VITE_ARCGIS_KEY (free ArcGIS Location Platform API key, "Basemap styles service" privilege) → Esri 0.3 m imagery.
# VITE_TERRAIN=ion
# VITE_IMAGERY=esri | ion | eox | none
VITE_ARCGIS_KEY=
VITE_CESIUM_ION_TOKEN=
VITE_API_BASE=/api
# Street-map tiles for the browse view; default is OpenStreetMap ({z}/{x}/{y}.png is appended)
# VITE_MAP_URL=https://tile.openstreetmap.org/
