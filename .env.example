# Copy to .env.local (git-ignored) and edit. Everything here is optional: `make` runs without it.
# The server reads the plain variables; the client reads VITE_* through Vite.

# --- Flight data ---------------------------------------------------------------------------------------------------
# adsbfi | adsblol | readsb | replay. `make` passes adsbfi and `make replay` passes replay, whatever is set here.
ADSB_SOURCE=replay
# An email or URL of yours for the User-Agent. Required for adsblol and the recorders.
CONTACT=you@example.com
# Upstream budget in requests a second. Unset = the source's polite default: adsbfi 0.9 (its public limit is 1),
# adsblol 0.04. `make live` passes these itself.
# MAX_RPS=
# Your own receiver (ADSB_SOURCE=readsb): its address, and its coverage as lat,lon,radius_nm.
READSB_URL=http://127.0.0.1:8042
READSB_COVERAGE=32.01,34.88,200
# Replay (ADSB_SOURCE=replay): the files, and how fast.
REPLAY_FILES=data/fixtures/*.jsonl
REPLAY_SPEED=1
# Where a live source's answers are recorded. Empty = do not record.
RECORD_DIR=data/recordings
# Where flights recorded with the flight card's Record button go, one file each. Unset = no Record button.
# `make` sets data/flights itself.
# FLIGHTS_DIR=data/flights
# Look up flight routes on adsb.lol (only with ADSB_SOURCE=adsblol; shares MAX_RPS). 1 = on.
ROUTES=0
# 1 = also serve aircraft flagged PIA or LADD (privacy programmes). Leave it at 0.
SHOW_PIA_LADD=0

# --- Server --------------------------------------------------------------------------------------------------------
PORT=8787

# --- Alerts (server/alerts.ts) -------------------------------------------------------------------------------------
# Emergency squawks and steep descents anywhere, from a live source only. EVENTS_DIR holds their switch and log:
# unset = no alerts. `make live` sets EVENTS_DIR=data/events itself.
# The switch starts off. Turn it on in the app's Events panel, or with
#   curl -X POST 'http://127.0.0.1:8787/api/events?on=1'      (on=0 turns it off; it is kept across restarts)
# EVENTS_DIR=data/events
# Push each new alert to your phone with ntfy (ntfy.sh needs no account): subscribe to the topic in the ntfy app.
# The topic works like a password: anyone who knows it can read the alerts. Pick a long random one. Unset = no push.
# NTFY_URL=https://ntfy.sh/your-long-random-topic
# The squawks read as emergencies: 4-digit octal codes, comma-separated. To try alerts out, sweep the common code
# 7000 into a log of its own, with NTFY_URL unset (it opens hundreds of events):
#   make live EVENTS_DIR=/tmp/fh-events ALERT_SQUAWKS=7000
# ALERT_SQUAWKS=7700,7600,7500

# --- Client: terrain and imagery -----------------------------------------------------------------------------------
# Both keys are optional and free. The app's setup guide (first start, or Settings → API keys) explains how to get
# them and saves them in the browser instead; a key saved there wins over these.
# Do not publish a build made with keys set here: Vite writes VITE_* values into the bundle.
# ArcGIS Location Platform API key with the "Basemap styles service" privilege → Esri World Imagery (0.3 m).
VITE_ARCGIS_KEY=
# Cesium ion access token → Cesium World Terrain.
VITE_CESIUM_ION_TOKEN=
# Force a source: VITE_TERRAIN=ion | reearth | ellipsoid, VITE_IMAGERY=esri | ion | eox | none.
# VITE_TERRAIN=
# VITE_IMAGERY=
VITE_API_BASE=/api
# Street-map tiles for the map view; default is OpenStreetMap ({z}/{x}/{y}.png is appended).
# VITE_MAP_URL=https://tile.openstreetmap.org/
