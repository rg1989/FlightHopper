{
  "env": {
    "PATH": "$(PATH):$(HOME)/.local/bin"
  },
  "apps": [
    {
      "name": "FlightHopper",
      "image-path": "/home/YOUR_USER/.local/share/flighthopper-tv/boxart.png",
      "prep-cmd": [
        {
          "do": "/home/YOUR_USER/.local/bin/fh-tv-start",
          "undo": "/home/YOUR_USER/.local/bin/fh-tv-stop"
        }
      ],
      "auto-detach": "true",
      "wait-all": "true",
      "exit-timeout": "5"
    }
  ]
}
