#!/bin/bash
# The FlightHopper kiosk for the TV. fh-tv-start runs it through Hyprland, so Hyprland owns it, and a window rule in
# ~/.config/hypr/flighthopper-tv.lua puts it full-screen on FHTV. Device scale 4 on the 4K output: the page lays out
# at 960x540 CSS px (Android TV's 10-foot size), readable from the sofa. ?tv=1 turns on the remote-control navigation.
exec chromium --ozone-platform=wayland --class=flighthopper-tv \
  --user-data-dir="$HOME/.local/share/flighthopper-tv/chrome" \
  --kiosk --no-first-run --noerrdialogs --disable-session-crashed-bubble --hide-crash-restore-bubble \
  --password-store=basic --disable-features=Translate --autoplay-policy=no-user-gesture-required \
  --ignore-gpu-blocklist --enable-gpu-rasterization --force-device-scale-factor=4 \
  "http://localhost:8787/?tv=1"
