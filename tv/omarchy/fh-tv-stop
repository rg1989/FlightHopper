#!/bin/bash
# Sunshine prep command ("undo") of the FlightHopper app: closes the kiosk and removes the TV's headless screen, so
# nothing renders or polls adsb.fi once the TV has quit the app.
pkill -f 'flighthopper-tv/[c]hrome'
for _ in $(seq 25); do pgrep -f 'flighthopper-tv/[c]hrome' >/dev/null || break; sleep 0.2; done
hyprctl output remove FHTV >/dev/null 2>&1
exit 0
